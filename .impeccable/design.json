      "css": ".ds-tree{display:flex;align-items:center;min-height:52px;background:#A0F2DF;color:#17201C}.ds-tree-expand{display:flex;align-items:center;justify-content:center;flex:0 0 48px;width:48px;height:48px;padding:12px;border:0;background:transparent;color:inherit;cursor:pointer}.ds-tree-title{font-family:Roboto,Arial,sans-serif;flex:1;text-align:left;min-height:52px;padding:8px 12px 8px 0;border:0;background:transparent;color:inherit;font-size:16px;font-weight:700;cursor:pointer}.ds-tree-expand:hover,.ds-tree-title:hover{background:rgba(23,32,28,.06)}.ds-tree-expand:focus-visible,.ds-tree-title:focus-visible{outline:2px solid #006B5F;outline-offset:-2px}.ds-tree-expand:active,.ds-tree-title:active{background:rgba(23,32,28,.12)}"
    },
