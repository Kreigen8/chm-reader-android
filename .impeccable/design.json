      "html": "<label class=\"ds-field\"><span>Название раздела или текст</span><input type=\"search\" aria-label=\"Название раздела или текст\" /></label>",
      "css": ".ds-field{font-family:Roboto,Arial,sans-serif;display:flex;flex-direction:column;gap:4px;padding:8px 16px;border:1px solid #707972;border-radius:4px;color:#414943;font-size:12px}.ds-field input{font-family:Roboto,Arial,sans-serif;width:100%;border:0;outline:none;background:transparent;color:#17201C;font-size:16px;min-height:28px}.ds-field:hover{border-color:#17201C}.ds-field:focus-within{border-color:#006B5F;outline:1px solid #006B5F;color:#006B5F}"
    },
    {
      "name": "Reader toolbar",
      "kind": "nav",
      "refersTo": "toolbar",
      "description": "Compact toolbar with contents, search and always-visible open. HTML preview approximates the native widget at unit density; Android owns exact text metrics, shape and ripple.",
      "html": "<nav class=\"ds-toolbar\" aria-label=\"Действия справочника\"><button aria-label=\"Оглавление\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M3,5h18v2H3zM3,11h18v2H3zM3,17h18v2H3z\"/></svg></button><span>CHM Reader</span><button aria-label=\"Поиск\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M9.5,3a6.5,6.5 0,1 0,4.1 11.55L20,21l1,-1 -6.45,-6.4A6.5,6.5 0,0 0,9.5 3M9.5,5a4.5,4.5 0,1 1,0 9a4.5,4.5 0,1 1,0 -9\"/></svg></button><button aria-label=\"Открыть CHM\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M10,4H2v16h20V6H12zM4,8h16v10H4z\"/></svg></button></nav>",
      "css": ".ds-toolbar{font-family:Roboto,Arial,sans-serif;display:flex;align-items:center;height:64px;background:#F7FAF8;color:#17201C;padding:0 4px;gap:4px}.ds-toolbar>span{flex:1;font-size:22px}.ds-toolbar button{display:flex;align-items:center;justify-content:center;min-width:48px;height:48px;padding:12px;border:0;border-radius:50%;background:transparent;color:inherit;cursor:pointer}.ds-toolbar button:hover{background:#DAE5DF}.ds-toolbar button:focus-visible{outline:2px solid #006B5F}.ds-toolbar button:active{background:#A0F2DF}"
    },
    {
      "name": "Page history",
      "kind": "nav",
      "refersTo": "history-navigation",
      "description": "History arrows, two-line page label and home. HTML preview approximates the native widget at unit density; Android owns exact text metrics, shape and ripple.",
      "html": "<nav class=\"ds-history\" aria-label=\"История страниц\"><button disabled aria-label=\"Назад по истории\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M20,11H7.8l5.6,-5.6L12,4l-8,8 8,8 1.4,-1.4L7.8,13H20z\"/></svg></button><button aria-label=\"Вперёд по истории\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M4,11h12.2l-5.6,-5.6L12,4l8,8 -8,8 -1.4,-1.4L16.2,13H4z\"/></svg></button><span>Текущий раздел</span><button aria-label=\"Начальная страница\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M3,10L12,2l9,8v12h-7v-8h-4v8H3zM5,11v9h3v-8h8v8h3v-9l-7,-6z\"/></svg></button></nav>",
      "css": ".ds-history{font-family:Roboto,Arial,sans-serif;display:flex;align-items:center;min-height:48px;padding:0 4px;background:#F7FAF8;color:#17201C}.ds-history>span{flex:1;padding:0 8px 0 12px;font-size:13px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.ds-history button{display:flex;align-items:center;justify-content:center;width:48px;height:48px;padding:12px;border:0;border-radius:50%;background:transparent;color:inherit;cursor:pointer}.ds-history button:hover:enabled{background:#DAE5DF}.ds-history button:focus-visible{outline:2px solid #006B5F}.ds-history button:active:enabled{background:#A0F2DF}.ds-history button:disabled{opacity:.35;cursor:default}"
