      "html": "<button class=\"ds-primary\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M10,4H2v16h20V6H12zM4,8h16v10H4z\"/></svg><span>Открыть CHM</span></button>",
